# Copy to .env (gitignored). moon loads it into the prompt-evals eval tasks, and
# `moon run scripts:compose-up` / `compose-down` pass it to Docker Compose, which
# sets the PROMPT_EVALS_LLM_* variables in the container. Variables set in the
# shell take precedence over it.

# OpenAI-compatible endpoint, its API key, and the id of the evaluated model as
# that endpoint names it (e.g. Qwen/Qwen3.8-27B). From the etc/docker container,
# a model served on the host is reachable as http://host.docker.internal:<port>/v1.
PROMPT_EVALS_LLM_BASE_URL=
PROMPT_EVALS_LLM_API_KEY=
PROMPT_EVALS_LLM_MODEL=

# Names this checkout's compose project (mbk-<WORKTREE>). Empty means `main` in
# the main checkout and the folder name in a linked worktree.
WORKTREE=

# UID/GID of the container's `dev` user. Match your host user (`id -u`, `id -g`)
# so files written into the checkout keep your ownership.
UID=1000
GID=1000
