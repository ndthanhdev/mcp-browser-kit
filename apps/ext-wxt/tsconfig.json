{
	"extends": "./.wxt/tsconfig.json",
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"jsx": "react-jsx",
		"outDir": "../../.moon/cache/types/apps/ext-wxt",
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"paths": {
			// Declaring `paths` here replaces the block WXT generates in
			// .wxt/tsconfig.json, so WXT's own `@/*` srcDir alias is restated.
			"@/*": [
				"./*"
			],
			"@mcp-browser-kit/branding/*": [
				"../../etc/branding/*"
			],
			"@mcp-browser-kit/extension-driven-browser-driver": [
				"../../packages/extension-driven-browser-driver/src/index.ts"
			],
			"@mcp-browser-kit/extension-driven-browser-driver/*": [
				"../../packages/extension-driven-browser-driver/src/*"
			],
			"@mcp-browser-kit/extension-driven-llm-provider": [
				"../../packages/extension-driven-llm-provider/src/index.ts"
			],
			"@mcp-browser-kit/extension-driven-llm-provider/*": [
				"../../packages/extension-driven-llm-provider/src/*"
			],
			"@mcp-browser-kit/extension-driving-agent-rpc": [
				"../../packages/extension-driving-agent-rpc/src/index.ts"
			],
			"@mcp-browser-kit/extension-driving-agent-rpc/*": [
				"../../packages/extension-driving-agent-rpc/src/*"
			],
			"@mcp-browser-kit/driven-logger-factory": [
				"../../packages/driven-logger-factory/src/index.ts"
			],
			"@mcp-browser-kit/driven-logger-factory/*": [
				"../../packages/driven-logger-factory/src/*"
			],
			"@mcp-browser-kit/helper-extension-keep-alive": [
				"../../packages/helper-extension-keep-alive/src/index.ts"
			],
			"@mcp-browser-kit/helper-extension-keep-alive/*": [
				"../../packages/helper-extension-keep-alive/src/*"
			],
			"@mcp-browser-kit/helper-extension-tab-lifecycle": [
				"../../packages/helper-extension-tab-lifecycle/src/index.ts"
			],
			"@mcp-browser-kit/helper-extension-tab-lifecycle/*": [
				"../../packages/helper-extension-tab-lifecycle/src/*"
			],
			"@mcp-browser-kit/core-extension": [
				"../../packages/core-extension/src/index.ts"
			],
			"@mcp-browser-kit/core-extension/*": [
				"../../packages/core-extension/src/*"
			],
			"@mcp-browser-kit/driven-feature-flags": [
				"../../packages/driven-feature-flags/src/index.ts"
			],
			"@mcp-browser-kit/driven-feature-flags/*": [
				"../../packages/driven-feature-flags/src/*"
			],
			"@mcp-browser-kit/core-feature-flags": [
				"../../packages/core-feature-flags/src/index.ts"
			],
			"@mcp-browser-kit/core-feature-flags/*": [
				"../../packages/core-feature-flags/src/*"
			],
			"@mcp-browser-kit/core-utils": [
				"../../packages/core-utils/src/index.ts"
			],
			"@mcp-browser-kit/core-utils/*": [
				"../../packages/core-utils/src/*"
			],
			"@mcp-browser-kit/types": [
				"../../packages/types/src/index.ts"
			],
			"@mcp-browser-kit/types/*": [
				"../../packages/types/src/*"
			]
		}
	},
	"references": [
		{
			"path": "../../packages/helper-extension-keep-alive"
		},
		{
			"path": "../../packages/helper-extension-tab-lifecycle"
		},
		{
			"path": "../../packages/extension-driven-browser-driver"
		},
		{
			"path": "../../packages/extension-driven-llm-provider"
		},
		{
			"path": "../../packages/extension-driving-agent-rpc"
		},
		{
			"path": "../../packages/driven-logger-factory"
		},
		{
			"path": "../../packages/core-extension"
		},
		{
			"path": "../../packages/driven-feature-flags"
		},
		{
			"path": "../../packages/core-feature-flags"
		},
		{
			"path": "../../packages/core-utils"
		},
		{
			"path": "../../packages/types"
		}
	]
}
