{
	"extends": "../../tsconfig.options.json",
	"include": [
		"**/*"
	],
	"references": [
		{
			"path": "../core-extension"
		},
		{
			"path": "../driven-logger-factory"
		},
		{
			"path": "../extension-driven-browser-driver"
		},
		{
			"path": "../helper-extension-keep-alive"
		}
	],
	"compilerOptions": {
		"outDir": "../../.moon/cache/types/packages/helper-extension-tab-lifecycle",
		"lib": [
			"dom",
			"ESNext"
		],
		"paths": {
			"@mcp-browser-kit/core-extension": [
				"../core-extension/src/index.ts"
			],
			"@mcp-browser-kit/core-extension/*": [
				"../core-extension/src/*"
			],
			"@mcp-browser-kit/driven-logger-factory": [
				"../driven-logger-factory/src/index.ts"
			],
			"@mcp-browser-kit/driven-logger-factory/*": [
				"../driven-logger-factory/src/*"
			],
			"@mcp-browser-kit/extension-driven-browser-driver": [
				"../extension-driven-browser-driver/src/index.ts"
			],
			"@mcp-browser-kit/extension-driven-browser-driver/*": [
				"../extension-driven-browser-driver/src/*"
			],
			"@mcp-browser-kit/helper-extension-keep-alive": [
				"../helper-extension-keep-alive/src/index.ts"
			],
			"@mcp-browser-kit/helper-extension-keep-alive/*": [
				"../helper-extension-keep-alive/src/*"
			]
		}
	}
}
